{
  "name": "@dsh-my-plugin/observability",
  "description": "个人 DSH 插件仓库的共享可观测性层：统一的结构化事件记录、$DSH_HOME 下 JSON 原子持久化、指标聚合与查询。所有 @dsh-my-plugin/* 插件共用，用于度量插件效果并支撑后续优化。",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.20.0",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -b && tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf lib tsconfig.tsbuildinfo"
  }
}